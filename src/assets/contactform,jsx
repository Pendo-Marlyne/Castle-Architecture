import { useEffect, useRef, useState } from 'react';
import { AlertCircle, CheckCircle2, Loader2 } from 'lucide-react';
import Button from './Button.jsx';
import { projectTypes, contactMethods, validate, limits } from '../utils/enquiry.js';
import { site } from '../config/site.js';

const labels = {
  name: 'Full name',
  email: 'Email address',
  phone: 'Telephone number',
  organisation: 'Organisation',
  projectType: 'Type of project',
  location: 'Project location',
  budget: 'Estimated budget',
  contactMethod: 'Preferred contact method',
  message: 'Project description',
  consultationDate: 'Preferred consultation date',
  consent: 'Privacy consent',
};

const hints = {
  phone: 'Required if you prefer to be contacted by telephone or WhatsApp.',
  budget: 'A rough range or description is fine. Include the currency.',
  message: 'Tell us about the site, what you want to build and your timeline.',
};

const empty = {
  name: '', email: '', phone: '', organisation: '', projectType: '', location: '', budget: '',
  contactMethod: 'Email', message: '', consultationDate: '', consent: false, website: '',
};

const inputCls = (invalid) =>
  `min-h-[48px] w-full border bg-white px-4 py-3 text-sm text-charcoal placeholder:text-grey-deep focus:border-burgundy ${
    invalid ? 'border-red-800' : 'border-charcoal/25'
  }`;

function Field({ id, label, required, hint, error, children }) {
  return (
    <div>
      <label htmlFor={id} className="block text-sm font-medium text-charcoal">
        {label}
        {required ? (
          <span aria-hidden="true" className="text-burgundy"> *</span>
        ) : (
          <span className="font-normal text-grey-deep"> (optional)</span>
        )}
      </label>
      {hint && <p id={`${id}-hint`} className="mt-1 text-xs text-grey-deep">{hint}</p>}
      <div className="mt-2">{children}</div>
      {error && (
        <p id={`${id}-error`} className="mt-2 flex items-start gap-2 text-sm text-red-800">
          <AlertCircle size={16} aria-hidden="true" className="mt-0.5 shrink-0" />
          {error}
        </p>
      )}
    </div>
  );
}

export default function ContactForm({ initial = {} }) {
  const [values, setValues] = useState({ ...empty, ...initial });
  const [errors, setErrors] = useState({});
  const [status, setStatus] = useState('idle'); // idle | submitting | success | error
  const [serverMsg, setServerMsg] = useState('');
  const [attempt, setAttempt] = useState(0);
  const startedAt = useRef(Date.now());
  const summaryRef = useRef(null);
  const successRef = useRef(null);
  const failRef = useRef(null);
  const today = new Date().toISOString().slice(0, 10);

  const errorKeys = Object.keys(errors).filter((k) => errors[k]);

  useEffect(() => { if (attempt > 0) summaryRef.current?.focus(); }, [attempt]);
  useEffect(() => { if (status === 'success') successRef.current?.focus(); }, [status]);
  useEffect(() => { if (status === 'error') failRef.current?.focus(); }, [status]);

  const onChange = (e) => {
    const { name, type, checked, value } = e.target;
    setValues((v) => ({ ...v, [name]: type === 'checkbox' ? checked : value }));
    if (errors[name]) setErrors((er) => ({ ...er, [name]: undefined }));
  };

  const onBlur = (e) => {
    const { name } = e.target;
    if (name === 'website') return;
    setErrors((er) => ({ ...er, [name]: validate(values)[name] }));
  };

  const fieldProps = (name) => ({
    id: name,
    name,
    value: values[name],
    onChange,
    onBlur,
    'aria-invalid': errors[name] ? 'true' : undefined,
    'aria-describedby': [hints[name] && `${name}-hint`, errors[name] && `${name}-error`].filter(Boolean).join(' ') || undefined,
  });

  const fallbackNote = site.contact.email ? ` You can also email us directly at ${site.contact.email}.` : '';

  const submit = async (e) => {
    e.preventDefault();
    if (status === 'submitting') return;
    const found = validate(values);
    setErrors(found);
    if (Object.keys(found).length) {
      setAttempt((a) => a + 1);
      return;
    }
    setStatus('submitting');
    setServerMsg('');
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...values, startedAt: startedAt.current }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.ok) {
        setValues({ ...empty });
        setErrors({});
        setStatus('success');
        return;
      }
      if (res.status === 422 && data.errors) {
        setErrors(data.errors);
        setStatus('idle');
        setAttempt((a) => a + 1);
        return;
      }
      setServerMsg(
        res.status === 429
          ? 'Too many attempts. Please wait a few minutes and try again.'
          : res.status === 503
          ? 'The enquiry service is not set up yet, so your message was not sent.'
          : 'Something went wrong and your message was not sent.'
      );
      setStatus('error');
    } catch {
      setServerMsg('We could not reach the server, so your message was not sent. Please check your connection.');
      setStatus('error');
    }
  };

  if (status === 'success') {
    return (
      <div ref={successRef} tabIndex={-1} role="status" className="border border-gold bg-white p-8 outline-none md:p-12">
        <CheckCircle2 size={36} aria-hidden="true" className="text-gold-dark" />
        <h3 className="mt-5 text-4xl text-burgundy">Thank you. Your enquiry has been sent.</h3>
        <p className="mt-4 max-w-lg leading-relaxed text-grey-deep">
          We have received your message and will reply using your preferred contact method.
        </p>
        <Button type="button" variant="outline" className="mt-8" onClick={() => { startedAt.current = Date.now(); setStatus('idle'); }}>
          Send another enquiry
        </Button>
      </div>
    );
  }

  return (
    <form onSubmit={submit} noValidate aria-label="Project enquiry form" className="space-y-6">
      {errorKeys.length > 0 && (
        <div ref={summaryRef} tabIndex={-1} role="alert" className="border-l-2 border-red-800 bg-white p-5 outline-none">
          <p className="font-medium text-red-800">Please fix the following before sending:</p>
          <ul className="mt-3 space-y-1 text-sm">
            {errorKeys.map((k) => (
              <li key={k}>
                <button
                  type="button"
                  onClick={() => document.getElementById(k)?.focus()}
                  className="text-left text-red-800 underline underline-offset-2"
                >
                  {labels[k]}: {errors[k]}
                </button>
              </li>
            ))}
          </ul>
        </div>
      )}

      {status === 'error' && (
        <div ref={failRef} tabIndex={-1} role="alert" className="border-l-2 border-red-800 bg-white p-5 text-sm outline-none">
          <p className="font-medium text-red-800">{serverMsg}</p>
          <p className="mt-1 text-grey-deep">Please try again.{fallbackNote}</p>
        </div>
      )}

      <div className="grid gap-6 sm:grid-cols-2">
        <Field id="name" label={labels.name} required error={errors.name}>
          <input type="text" autoComplete="name" maxLength={limits.name} className={inputCls(errors.name)} {...fieldProps('name')} />
        </Field>
        <Field id="email" label={labels.email} required error={errors.email}>
          <input type="email" autoComplete="email" maxLength={limits.email} className={inputCls(errors.email)} {...fieldProps('email')} />
        </Field>
        <Field id="phone" label={labels.phone} hint={hints.phone} error={errors.phone}>
          <input type="tel" autoComplete="tel" maxLength={limits.phone} className={inputCls(errors.phone)} {...fieldProps('phone')} />
        </Field>
        <Field id="organisation" label={labels.organisation} error={errors.organisation}>
          <input type="text" autoComplete="organization" maxLength={limits.organisation} className={inputCls(errors.organisation)} {...fieldProps('organisation')} />
        </Field>
        <Field id="projectType" label={labels.projectType} required error={errors.projectType}>
          <select className={inputCls(errors.projectType)} {...fieldProps('projectType')}>
            <option value="">Select a project type</option>
            {projectTypes.map((t) => <option key={t} value={t}>{t}</option>)}
          </select>
        </Field>
        <Field id="location" label={labels.location} required error={errors.location}>
          <input type="text" maxLength={limits.location} placeholder="Town or city, country" className={inputCls(errors.location)} {...fieldProps('location')} />
        </Field>
        <Field id="budget" label={labels.budget} hint={hints.budget} error={errors.budget}>
          <input type="text" maxLength={limits.budget} className={inputCls(errors.budget)} {...fieldProps('budget')} />
        </Field>
        <Field id="contactMethod" label={labels.contactMethod} required error={errors.contactMethod}>
          <select className={inputCls(errors.contactMethod)} {...fieldProps('contactMethod')}>
            {contactMethods.map((m) => <option key={m} value={m}>{m}</option>)}
          </select>
        </Field>
      </div>

      <Field id="message" label={labels.message} required hint={hints.message} error={errors.message}>
        <textarea rows={6} maxLength={limits.message} className={inputCls(errors.message)} {...fieldProps('message')} />
      </Field>

      <div className="sm:max-w-xs">
        <Field id="consultationDate" label={labels.consultationDate} error={errors.consultationDate}>
          <input type="date" min={today} className={inputCls(errors.consultationDate)} {...fieldProps('consultationDate')} />
        </Field>
      </div>

      {/* Honeypot: hidden from people and assistive tech; bots tend to fill it. */}
      <div aria-hidden="true" className="absolute -left-[9999px] h-0 w-0 overflow-hidden">
        <label htmlFor="website">Leave this field empty</label>
        <input id="website" name="website" type="text" tabIndex={-1} autoComplete="off" value={values.website} onChange={onChange} />
      </div>

      <div>
        <div className="flex items-start gap-3">
          <input
            id="consent"
            name="consent"
            type="checkbox"
            checked={values.consent}
            onChange={onChange}
            aria-invalid={errors.consent ? 'true' : undefined}
            aria-describedby={errors.consent ? 'consent-error' : undefined}
            className="mt-1 h-5 w-5 shrink-0 accent-burgundy"
          />
          <label htmlFor="consent" className="text-sm leading-relaxed text-charcoal">
            I agree that Castle may use the information I have provided to respond to my enquiry, as described in the{' '}
            <a href="/privacy" target="_blank" rel="noopener noreferrer" className="text-burgundy underline underline-offset-2">
              privacy notice<span className="sr-only"> (opens in a new tab)</span>
            </a>
            . <span aria-hidden="true" className="text-burgundy">*</span>
          </label>
        </div>
        {errors.consent && (
          <p id="consent-error" className="mt-2 flex items-start gap-2 text-sm text-red-800">
            <AlertCircle size={16} aria-hidden="true" className="mt-0.5 shrink-0" />
            {errors.consent}
          </p>
        )}
      </div>

      <p className="text-xs text-grey-deep">Fields marked <span aria-hidden="true">*</span><span className="sr-only">with an asterisk</span> are required.</p>

      <Button type="submit" disabled={status === 'submitting'} aria-busy={status === 'submitting'}>
        {status === 'submitting' ? (
          <>
            <Loader2 size={16} aria-hidden="true" className="animate-spin" /> Sending…
          </>
        ) : (
          'Send Enquiry'
        )}
      </Button>
    </form>
  );
}